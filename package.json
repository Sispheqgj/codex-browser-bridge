{
  "dependencies": {
    "@mdit/plugin-katex": "1.2.0",
    "@mdit/plugin-tasklist": "1.3.0",
    "dompurify": "3.4.18",
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.3",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "31.0.1",
    "prettier": "3.10.1"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "start": "node src/server/index.mjs",
    "init": "node src/cli.mjs init",
    "doctor": "node src/cli.mjs doctor",
    "mcp": "node src/cli.mjs mcp",
    "check:release": "node scripts/check-release.mjs",
    "test:config": "node tests/config.test.mjs",
    "demo": "node examples/demo/server.mjs",
    "format": "prettier --ignore-path .gitignore --write .",
    "format:check": "prettier --ignore-path .gitignore --check .",
    "pretest": "npm run build",
    "predemo": "npm run build",
    "manifest": "node scripts/update-manifest.mjs"
  },
  "name": "codex-browser-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Experimental browser control for existing Codex desktop and SSH chats",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100
  }
}
